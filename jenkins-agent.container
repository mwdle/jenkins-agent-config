[Container]
Image=git.mwdle.com/lab/jenkins-agent:latest@sha256:8eeff4e37a136087063c1e7592086c37ad2b1cf5b07c511160fedecc900edc35
ContainerName=jenkins-agent

AddHost=jenkins.mwdle.com:host-gateway
AddHost=git.mwdle.com:host-gateway

Timezone=local

Environment=REMOTING_OPTS="-url https://jenkins.mwdle.com/ -webSocket -secret @/run/secrets/jenkins_agent_secret -name %H"

Secret=jenkins_agent_secret,uid=1000,gid=1000,mode=0400

Volume=/home/jenkins

ReadOnly=true

UserNS=auto
NoNewPrivileges=true
DropCapability=all

RunInit=true

HealthStartupCmd=grep -aqF agent.jar /proc/[0-9]*/cmdline || exit 1
HealthStartupInterval=3s
HealthStartupTimeout=5s
HealthCmd=grep -aqF agent.jar /proc/[0-9]*/cmdline || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=8G
PidsLimit=1024

[Service]
CPUQuota=400%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
