[Container]
Image=git.mwdle.com/lab/jenkins-agent:latest@sha256:618afe5b32ede2d5e7339ca2e9caf6cd9aceef6cf746811fc1da6e7c59fd2d87
ContainerName=jenkins-agent

AddHost=jenkins.mwdle.com:host-gateway
AddHost=git.mwdle.com:host-gateway

Environment=REMOTING_OPTS="-url https://jenkins.mwdle.com/ -webSocket -secret @/run/secrets/jenkins_agent_secret -name %H"
Environment=TZ=America/Denver

Secret=jenkins_agent_secret,uid=1000,gid=1000,mode=0400

Volume=/home/jenkins

ReadOnly=true
ShmSize=64M

UserNS=auto
NoNewPrivileges=true
DropCapability=all

RunInit=true

HealthStartupCmd=grep -aqF agent.jar /proc/[0-9]*/cmdline || exit 1
HealthStartupInterval=3s
HealthStartupTimeout=5s
HealthCmd=grep -aqF agent.jar /proc/[0-9]*/cmdline || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=8G
PidsLimit=1024

[Service]
CPUQuota=400%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
