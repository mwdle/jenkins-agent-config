[Container]
Image=git.mwdle.com/lab/jenkins-agent:latest@sha256:3158ae006e55cfbf510574b6d2f338df87098cf19fd79e37ff677b3e86c09f76
ContainerName=jenkins-agent

AddHost=jenkins.mwdle.com:host-gateway
AddHost=git.mwdle.com:host-gateway

Timezone=local

Environment=REMOTING_OPTS="-url https://jenkins.mwdle.com/ -webSocket -secret @/run/secrets/jenkins_agent_secret -name %H"

Secret=jenkins_agent_secret,uid=1000,gid=1000,mode=0400

Volume=/home/jenkins

ReadOnly=true

UserNS=auto
NoNewPrivileges=true
DropCapability=all

RunInit=true

HealthCmd=grep -aqF agent.jar /proc/[0-9]*/cmdline || exit 1
HealthStartupInterval=3s
HealthStartupTimeout=5s
HealthInterval=30s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=8G
PidsLimit=1024

[Service]
CPUQuota=400%
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
